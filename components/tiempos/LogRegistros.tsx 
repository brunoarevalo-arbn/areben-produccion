// components/tiempos/LogRegistros.tsx

'use client';

import { TiemposProduccion } from '@/types/tiempos';

interface LogRegistrosProps {
  registros: TiemposProduccion[];
  loading: boolean;
}

export function LogRegistros({ registros, loading }: LogRegistrosProps) {
  if (loading) {
    return (
      <div className="text-center text-gray-500 py-8">
        Cargando registros...
      </div>
    );
  }

  if (registros.length === 0) {
    return (
      <div className="text-center text-gray-500 py-8">
        📋 Los registros de hoy aparecerán aquí
      </div>
    );
  }

  return (
    <div className="space-y-2">
      {registros.map((reg) => (
        <div
          key={reg.id}
          className="bg-white rounded-lg p-4 border-l-4 border-blue-900 shadow-sm hover:shadow-md transition"
        >
          <div className="flex justify-between items-start mb-2">
            <div>
              <div className="font-bold text-gray-800 text-lg">
                {reg.actividad}
              </div>
              <div className="text-sm text-gray-600">
                {reg.marca && <span className="font-semibold">{reg.marca}</span>}
                {reg.sku && <span className="ml-2">📦 {reg.sku}</span>}
              </div>
            </div>
            <div className="text-right text-xs text-gray-500 bg-gray-100 px-2 py-1 rounded">
              {reg.cantidad > 0 && <div>{reg.cantidad} prendas</div>}
              {reg.defectos > 0 && (
                <div className="text-red-600 font-bold">{reg.defectos} defectos</div>
              )}
            </div>
          </div>

          <div className="text-xs text-gray-600 border-t pt-2">
            <div>
              {reg.horaInicio} → {reg.horaFin} | ⏱️ {reg.minutosNetos.toFixed(1)} min
            </div>
            {reg.maquina && <div className="text-gray-500">🔧 {reg.maquina}</div>}
          </div>
        </div>
      ))}
    </div>
  );
}

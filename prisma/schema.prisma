generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model TiemposProduccion {
  id                 String   @id @default(cuid())
  usuario            String
  actividad          String
  fecha              String
  marca              String?
  maquina            String?
  sku                String?
  cantidad           Int      @default(0)
  defectos           Int      @default(0)
  horaInicio         String?
  horaFin            String?
  minutosNetos       Float    @default(0)
  estado             String   @default("pendiente")
  inconveniente      String?
  inconvenienteNotas String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("tiempos_produccion")
}

model SkuCatalogo {
  id            String        @id @default(cuid())
  categoria     String        // 'marca' | 'prenda' | 'color' (extensible)
  nombre        String
  abreviatura   String
  orden         Int           @default(0)
  activo        Boolean       @default(true)
  insumoColores InsumoColor[]
  rollos        Rollo[]       @relation("RolloColor")
  lotes         Lote[]        @relation("LoteColor")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([categoria, abreviatura])
  @@index([categoria, activo])
  @@map("sku_catalogo")
}

model Producto {
  id          String            @id @default(cuid())
  nombre      String
  descripcion String?
  molderia    String?
  tela        String?
  colores     String?
  costoTela   Float             @default(0)
  costoMO     Float             @default(0)
  costoTotal  Float             @default(0)
  estado      String            @default("borrador")
  marca       String?
  temporada   String?
  fotos       Foto[]
  historial   HistorialDiseno[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("productos")
}

model Foto {
  id         String   @id @default(cuid())
  url        String
  nombre     String?
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@map("fotos")
}

model HistorialDiseno {
  id         String   @id @default(cuid())
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  version    Int
  cambios    String?
  snapshot   String
  creadoPor  String
  createdAt  DateTime @default(now())

  @@map("historial_diseno")
}

model ProyectoDiseno {
  id              String             @id @default(cuid())
  nombre          String
  marca           String
  archivado       Boolean            @default(false)
  inspiracion     String?
  moodboard       String?
  molderia        String?
  molderiaFormato String?
  tela            String?
  fechaObjetivo   DateTime?
  fases           FaseProyecto[]
  iteraciones     IteracionMuestra[]
  insumos         ProyectoInsumo[]
  skus            SKUProyecto[]
  movimientos     MovimientoInsumo[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@map("proyectos_diseno")
}

model FaseCatalogo {
  id        String         @id @default(cuid())
  nombre    String         @unique
  orden     Int            @default(0)
  activo    Boolean        @default(true)
  fases     FaseProyecto[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("fase_catalogo")
}

model FaseProyecto {
  id              String         @id @default(cuid())
  proyectoId      String
  proyecto        ProyectoDiseno @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  faseId          String
  fase            FaseCatalogo   @relation(fields: [faseId], references: [id])
  estado          String         @default("en_progreso") // en_progreso | completada
  responsable     String?
  externo         Boolean        @default(false)
  seguidorInterno String?
  fechaInicio     DateTime?
  fechaFin        DateTime?
  notas           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([proyectoId, faseId])
  @@map("fase_proyecto")
}

model IteracionMuestra {
  id              String          @id @default(cuid())
  proyectoId      String
  proyecto        ProyectoDiseno  @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  version         Int
  tipo            String          @default("muestra")
  estado          String          @default("en_confeccion")
  fotos           String?
  notas           String?         // qué falló / qué falta de la muestra física
  ajustesMolderia String?         // qué se cambió / se va a cambiar en la molderia
  ajustes         AjusteMuestra[]
  insumos         InsumoMuestra[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("iteraciones_muestra")
}

model AjusteMuestra {
  id             String           @id @default(cuid())
  iteracionId    String
  iteracion      IteracionMuestra @relation(fields: [iteracionId], references: [id], onDelete: Cascade)
  descripcion    String
  estado         String           @default("pendiente")
  fechaRealizado DateTime?
  createdAt      DateTime         @default(now())

  @@map("ajustes_muestra")
}

model InsumoMuestra {
  id          String           @id @default(cuid())
  iteracionId String
  iteracion   IteracionMuestra @relation(fields: [iteracionId], references: [id], onDelete: Cascade)
  nombre      String
  cantidad    Float            @default(1)
  unidad      String?
  costo       Float            @default(0)
  notas       String?

  @@map("insumos_muestra")
}

model ProyectoInsumo {
  id            String         @id @default(cuid())
  proyectoId    String
  proyecto      ProyectoDiseno @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  nombre        String
  tipo          String?
  proveedor     String?
  unidad        String         @default("m")
  cantidad      Float          @default(0)
  costoUnitario Float          @default(0)
  notas         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("proyecto_insumos")
}

model SKUProyecto {
  id         String         @id @default(cuid())
  proyectoId String
  proyecto   ProyectoDiseno @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  codigo     String
  talle      String?
  color      String?
  cantidad   Int            @default(0)
  notas      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@map("skus_proyecto")
}

model Usuario {
  id           String   @id @default(cuid())
  nombre       String
  username     String   @unique
  passwordHash String
  rol          String   @default("admin")
  permisos     String[] @default([])
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("usuarios")
}

model GastoFijoTaller {
  id          String   @id @default(cuid())
  nombre      String
  monto       Float    @default(0)
  categoria   String   @default("otro")
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("gastos_fijos_taller")
}

model CostoCosturera {
  id              String   @id @default(cuid())
  usuarioId       String   @unique
  sueldoBruto     Float    @default(0)
  cargasSociales  Float    @default(0)
  horasMes        Float    @default(160)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("costos_costureras")
}

model ConfigCostos {
  id               String   @id @default("singleton")
  margenDesarrollo Float    @default(10)
  margenFallas     Float    @default(5)
  updatedAt        DateTime @updatedAt

  @@map("config_costos")
}

model CostoSkuDescartado {
  sku       String   @id
  createdAt DateTime @default(now())

  @@map("costos_skus_descartados")
}

model Escandallo {
  id          String   @id @default(cuid())
  nombre      String
  sku         String?
  marca       String?
  tipoPrenda  String?
  proyectoId  String?
  notas       String?
  datos       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("escandallos")
}

// Catálogo de AVÍOS (en la UI se llama "Avíos": etiquetas, badanas, botones,
// hilos). El modelo se llama EtiquetaCatalogo por historia; EtiquetaCatalogo ≡
// Avío. El escandallo elige el avío y autocompleta el precio (snapshot).
// Es el sistema liviano que reemplazó al pesado (Insumo+Lote) para avíos.
model EtiquetaCatalogo {
  id        String   @id @default(cuid())
  nombre    String
  tipo      String?  // 'principal' | 'composicion' | 'otro'
  categoria String?  // 'etiqueta' | 'badana' | 'boton' | 'cierre' | 'tacha' | 'hilo' | 'otro'
  frecuencia String  @default("habitual") // 'habitual' (va siempre) | 'ocasional' (según la prenda)
  unidad    String?  // 'etiqueta' | 'unidad'
  marca     String?  // 'Zattia' | 'Stunned' | null
  precio    Decimal  @default(0)
  stock     Int?     // null = sin seguimiento / ilimitado. Se descuenta al terminar producción.
  activo    Boolean  @default(true)
  proveedorId String?
  proveedor   Proveedor? @relation(fields: [proveedorId], references: [id])
  ordenAvios OrdenAvio[]
  movimientos AvioMovimiento[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("etiqueta_catalogo")
}

// Movimientos de stock de un avío (ingreso por compra, egreso al terminar
// producción, ajuste manual). gastoId enlaza al Gasto-compra cuando el ingreso
// vino de una compra a proveedor (aparece en el módulo Compras).
model AvioMovimiento {
  id            String           @id @default(cuid())
  etiquetaId    String
  etiqueta      EtiquetaCatalogo @relation(fields: [etiquetaId], references: [id], onDelete: Cascade)
  tipo          String           // 'INGRESO' | 'EGRESO' | 'AJUSTE'
  cantidad      Int              // + ingreso / - egreso
  costoUnitario Decimal?
  gastoId       String?
  proveedorId   String?
  ordenId       String?          // para egresos al terminar producción
  motivo        String?
  creadoPor     String
  fecha         DateTime         @default(now())

  @@index([etiquetaId])
  @@map("avio_movimientos")
}

// Qué avíos (del catálogo) lleva una orden. Se cargan al registrar el corte
// (ideal) o desde el escandallo (fallback). El stock se descuenta una sola vez
// al terminar producción (guard OrdenProduccion.aviosDescontados).
model OrdenAvio {
  id         String           @id @default(cuid())
  ordenId    String
  orden      OrdenProduccion  @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  etiquetaId String
  etiqueta   EtiquetaCatalogo @relation(fields: [etiquetaId], references: [id])
  cantidad   Int              @default(1) // cantidad por prenda
  origen     String           @default("corte") // 'corte' | 'escandallo'
  createdAt  DateTime         @default(now())

  @@unique([ordenId, etiquetaId])
  @@map("orden_avios")
}

// Costo de corte de referencia por tipo de prenda. Da independencia al cargar
// el costo de corte: se elige el tipo de prenda y trae el costo configurado.
model CostoCortePrenda {
  id         String   @id @default(cuid())
  tipoPrenda String   @unique
  costo      Decimal  @default(0)
  activo     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("costo_corte_prenda")
}

enum EstadoOP {
  PENDIENTE
  CORTE
  COSTURA
  TERMINADO_SIN_ESTAMPA
  ESTAMPA
  CONTROL_CALIDAD
  CERRADA
}

model OrdenProduccion {
  id                      String    @id @default(cuid())
  sku                     String?
  descripcion             String?
  marca                   String    @default("Zattia")
  cantidad                Int       @default(1)
  estado                  EstadoOP  @default(PENDIENTE)
  notas                   String?
  creadoPor               String    @default("admin")
  terminadoAt             DateTime?

  fichaCorteCargada       Boolean   @default(false)
  fichaFotoUrl            String?

  avios                   OrdenAvio[]
  aviosDescontados        Boolean   @default(false) // guard: el stock de avíos se descuenta una sola vez

  cortador                String?
  cortadorId              String?
  cortadorRef             Cortador? @relation(fields: [cortadorId], references: [id])
  costoCorte              Decimal   @default(0)
  pagoCorteId             String?
  pagoCorte               PagoCorte? @relation(fields: [pagoCorteId], references: [id])

  costoTela               Decimal   @default(0)
  costoInsumosSecundarios Decimal   @default(0)
  costoManoObra           Decimal   @default(0)
  costoEstampa            Decimal   @default(0)
  costoTotal              Decimal   @default(0)

  transiciones            EstadoTransicion[]
  movimientosInsumo       MovimientoInsumo[]
  cortesPorTalle          CortePorTalle[]

  loteId                  String?
  lote                    LoteProduccion? @relation(fields: [loteId], references: [id], onDelete: SetNull)

  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([loteId])
  @@map("ordenes_produccion")
}

// Agrupa las órdenes hermanas (mismo molde/prenda, distinto color) de una misma
// producción. Es opcional y aditivo: una OP sin lote funciona como siempre.
model LoteProduccion {
  id          String            @id @default(cuid())
  marca       String            @default("Zattia")
  prenda      String?           // abreviatura de la prenda (molde)
  descripcion String?
  notas       String?
  creadoPor   String            @default("admin")
  ordenes     OrdenProduccion[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("lotes_produccion")
}

model CortePorTalle {
  id        String          @id @default(cuid())
  ordenId   String
  orden     OrdenProduccion @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  talle     String
  cantidad  Int
  createdAt DateTime        @default(now())

  @@unique([ordenId, talle])
  @@map("cortes_por_talle")
}

model PagoCorte {
  id             String            @id @default(cuid())
  fecha          DateTime          @default(now())
  beneficiario   String
  montoTotal     Decimal
  notas          String?
  comprobanteUrl String?
  creadoPor      String
  createdAt      DateTime          @default(now())
  ordenes        OrdenProduccion[]

  @@map("pagos_cortes")
}

model Cortador {
  id            String            @id @default(cuid())
  nombre        String            @unique
  contacto      String?
  tarifaDefault Decimal?
  tarifaModo    String?           // 'total' | 'unidad'
  notas         String?
  activo        Boolean           @default(true)
  ordenes       OrdenProduccion[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@map("cortadores")
}

model MotivoDescarte {
  id          String             @id @default(cuid())
  nombre      String             @unique
  categoria   String             // 'proveedor' | 'corte' | 'costura' | 'estampa' | 'otro'
  activo      Boolean            @default(true)
  movimientos MovimientoInsumo[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("motivos_descarte")
}

model EstadoTransicion {
  id             String           @id @default(cuid())
  ordenId        String
  orden          OrdenProduccion  @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  estadoAnterior EstadoOP?
  estadoNuevo    EstadoOP
  fecha          DateTime         @default(now())
  usuarioId      String
  notas          String?

  @@map("estado_transiciones")
}

model MolderiaCatalogo {
  id        String   @id @default(cuid())
  nombre    String   @unique
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("molderia_catalogo")
}

model TelaCatalogo {
  id          String   @id @default(cuid())
  nombre      String   @unique
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tela_catalogo")
}

model Gasto {
  id        String   @id @default(cuid())
  categoria String   // 'desarrollo' | 'produccion'
  tipo      String   // 'tela' | 'insumos' | 'periodo'
  marca     String?  // 'Zattia' | 'Stunned' — para desarrollo
  sku       String?
  ordenId   String?  // FK a OrdenProduccion — para produccion
  minutos   Int?
  monto     Float    @default(0)
  concepto  String?
  fecha     String
  creadoPor String
  tiempoId  String?

  // Compra a proveedor (cuando proveedorId != null, el gasto es una "compra" y
  // aparece en el módulo Compras). Los gastos automáticos van sin proveedor.
  proveedorId   String?
  proveedor     Proveedor?  @relation(fields: [proveedorId], references: [id])
  numeroFactura String?
  formaPago     String?
  estadoPago    EstadoPago? // null = sin seguimiento de pago (registro simple)
  montoPagado   Decimal?
  fechaPago     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("gastos")
}

// ─── Capital de Producción — Fase 1 ────────────────────────────────

model Proveedor {
  id           String   @id @default(cuid())
  nombre       String
  cuit         String?
  condicionIva String?
  contacto     String?
  notas        String?
  activo       Boolean  @default(true)
  compras      Compra[]
  gastos       Gasto[]
  etiquetas    EtiquetaCatalogo[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("proveedores")
}

enum EstadoPago {
  PENDIENTE
  PARCIAL
  PAGADA
}

model Compra {
  id            String     @id @default(cuid())
  proveedorId   String
  proveedor     Proveedor  @relation(fields: [proveedorId], references: [id])
  fecha         DateTime
  numeroFactura String?
  conIva        Boolean    @default(true)
  totalBruto    Decimal
  totalNeto     Decimal
  costoEnvio    Decimal    @default(0) // flete/envío en pesos, prorrateado al costo de los rollos/lotes (si fleteModo='porcentaje', es el equivalente calculado)
  fleteModo     String     @default("monto")  // 'monto' (pesos) | 'porcentaje'
  fletePorcentaje Decimal? // % ingresado cuando fleteModo='porcentaje' (para recordarlo al editar)
  formaPago     String?
  estadoPago    EstadoPago @default(PENDIENTE)
  montoPagado   Decimal    @default(0)
  fechaPago     DateTime?
  notas         String?
  revertida     Boolean    @default(false)
  revertidaAt   DateTime?
  revertidaPor  String?
  creadoPor     String
  creadoAt      DateTime   @default(now())
  lineas        CompraLinea[]
  rollos        Rollo[]
  lotes         Lote[]

  @@map("compras")
}

model CompraLinea {
  id             String  @id @default(cuid())
  compraId       String
  compra         Compra  @relation(fields: [compraId], references: [id], onDelete: Cascade)
  insumoId       String
  insumo         Insumo  @relation(fields: [insumoId], references: [id])
  cantidad       Decimal
  unidad         String
  precioUnitario Decimal
  subtotal       Decimal

  @@map("compra_lineas")
}

model Insumo {
  id               String        @id @default(cuid())
  nombre           String                       // nombre del artículo (suele ser el del proveedor)
  nombreInterno    String?                      // nombre interno opcional (ref al catálogo de telas)
  categoria        String
  tipoTrazabilidad String
  unidadDefault    String
  stockMinimo      Decimal?
  manejaColor      Boolean       @default(false)
  rinde            Decimal?
  activo           Boolean       @default(true)
  colores          InsumoColor[]
  rollos           Rollo[]
  lotes            Lote[]
  lineasCompra     CompraLinea[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@map("insumos")
}

model InsumoColor {
  id             String      @id @default(cuid())
  insumoId       String
  insumo         Insumo      @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  skuCatalogoId  String
  skuCatalogo    SkuCatalogo @relation(fields: [skuCatalogoId], references: [id])
  activo         Boolean     @default(true)

  @@unique([insumoId, skuCatalogoId])
  @@map("insumo_colores")
}

enum EstadoRollo {
  DISPONIBLE
  EN_USO_PARCIAL
  AGOTADO
  DESCARTADO
}

model Rollo {
  id            String             @id @default(cuid())
  codigo        String             @unique
  insumoId      String
  insumo        Insumo             @relation(fields: [insumoId], references: [id])
  colorId       String?
  color         SkuCatalogo?       @relation("RolloColor", fields: [colorId], references: [id])
  colorProveedor String?           // nombre comercial del color que pone el proveedor (ej. "Lindt")
  compraId      String
  compra        Compra             @relation(fields: [compraId], references: [id])
  pesoInicial   Decimal
  pesoActual    Decimal
  costoUnitario Decimal
  estado        EstadoRollo        @default(DISPONIBLE)
  ubicacion     String?
  fotoUrl       String?
  movimientos   MovimientoInsumo[]
  createdAt     DateTime           @default(now())

  @@map("rollos")
}

enum EstadoLote {
  DISPONIBLE
  EN_USO_PARCIAL
  AGOTADO
}

model Lote {
  id              String             @id @default(cuid())
  codigo          String             @unique
  insumoId        String
  insumo          Insumo             @relation(fields: [insumoId], references: [id])
  colorId         String?
  color           SkuCatalogo?       @relation("LoteColor", fields: [colorId], references: [id])
  colorProveedor  String?            // nombre comercial del color que pone el proveedor (ej. "Lindt")
  compraId        String
  compra          Compra             @relation(fields: [compraId], references: [id])
  cantidadInicial Decimal
  cantidadActual  Decimal
  costoUnitario   Decimal
  estado          EstadoLote         @default(DISPONIBLE)
  movimientos     MovimientoInsumo[]
  createdAt       DateTime           @default(now())

  @@map("lotes")
}

enum TipoMovimiento {
  INGRESO
  CONSUMO
  AJUSTE
  DESCARTE
  REVERSION
  MUESTRA
}

model MovimientoInsumo {
  id               String            @id @default(cuid())
  tipo             TipoMovimiento
  rolloId          String?
  rollo            Rollo?            @relation(fields: [rolloId], references: [id])
  loteId           String?
  lote             Lote?             @relation(fields: [loteId], references: [id])
  ordenId          String?
  orden            OrdenProduccion?  @relation(fields: [ordenId], references: [id])
  proyectoId       String?
  proyecto         ProyectoDiseno?   @relation(fields: [proyectoId], references: [id])
  cantidad         Decimal
  motivo           String?
  motivoDescarteId String?
  motivoDescarte   MotivoDescarte?   @relation(fields: [motivoDescarteId], references: [id])
  fotoUrl          String?
  usuarioId        String
  fecha            DateTime          @default(now())
  revertidoPor     String?
  reversionNota    String?

  @@map("movimientos_insumo")
}

// ─── Stock de productos terminados (lisos / estampados) ────────────────
// Lo que sale de costura (liso) ingresa acá por SKU + talle. Estampa
// consumirá lisos y generará estampados (mismo modelo, tipo distinto).

model StockTerminado {
  id        String   @id @default(cuid())
  sku       String
  talle     String
  tipo      String   @default("liso") // 'liso' | 'estampado'
  cantidad  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sku, talle, tipo])
  @@index([sku])
  @@map("stock_terminado")
}

model MovimientoTerminado {
  id        String   @id @default(cuid())
  sku       String
  talle     String
  tipo      String   @default("liso")
  cantidad  Int      // + ingreso / - egreso
  origen    String   // 'produccion' | 'estampa' | 'venta' | 'ajuste'
  ordenId   String?
  motivo    String?
  creadoPor String
  fecha     DateTime @default(now())

  @@index([sku])
  @@map("movimientos_terminado")
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model TiemposProduccion {
  id                 String   @id @default(cuid())
  usuario            String
  actividad          String
  fecha              String
  marca              String?
  maquina            String?
  sku                String?
  cantidad           Int      @default(0)
  defectos           Int      @default(0)
  horaInicio         String?
  horaFin            String?
  minutosNetos       Float    @default(0)
  estado             String   @default("pendiente")
  inconveniente      String?
  inconvenienteNotas String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  solicitudes        SolicitudCambioTiempo[]

  @@map("tiempos_produccion")
}

// Solicitud de la costurera para corregir SKU/máquina de un registro propio del día.
// No se aplica sola: el admin la aprueba y recién ahí se cambia el registro.
model SolicitudCambioTiempo {
  id              String            @id @default(cuid())
  tiempoId        String
  tiempo          TiemposProduccion @relation(fields: [tiempoId], references: [id], onDelete: Cascade)
  solicitadaPor   String            // nombre de la costurera
  skuAnterior     String?
  maquinaAnterior String?
  skuNuevo        String?           // null = ese campo no se cambia
  maquinaNueva    String?
  estado          String            @default("pendiente") // 'pendiente' | 'aprobada' | 'rechazada'
  resueltaPor     String?
  resueltaAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([estado])
  @@map("solicitudes_cambio_tiempo")
}

// Estudio de tiempos de estampado: cada registro es una TANDA (armado + estampar+sellar,
// un solo tiempo) con cuántas estampas se aplicaron. Estándar = minutosNetos / cantidad.
model TiemposEstampado {
  id           String   @id @default(cuid())
  usuario      String   // estampador (nombre)
  fecha        String   // YYYY-MM-DD
  cantidad     Int      @default(0) // estampas aplicadas en la tanda
  minutosNetos Float    @default(0) // tiempo total de la tanda
  horaInicio   String?
  horaFin      String?
  estado       String   @default("guardado")
  notas        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("tiempos_estampado")
}

model SkuCatalogo {
  id            String        @id @default(cuid())
  categoria     String        // 'marca' | 'prenda' | 'color' (extensible)
  nombre        String
  abreviatura   String
  orden         Int           @default(0)
  activo        Boolean       @default(true)
  insumoColores InsumoColor[]
  rollos        Rollo[]       @relation("RolloColor")
  lotes         Lote[]        @relation("LoteColor")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([categoria, abreviatura])
  @@index([categoria, activo])
  @@map("sku_catalogo")
}

model Producto {
  id          String            @id @default(cuid())
  nombre      String
  descripcion String?
  molderia    String?
  tela        String?
  colores     String?
  costoTela   Float             @default(0)
  costoMO     Float             @default(0)
  costoTotal  Float             @default(0)
  estado      String            @default("borrador")
  marca       String?
  temporada   String?
  fotos       Foto[]
  historial   HistorialDiseno[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("productos")
}

model Foto {
  id         String   @id @default(cuid())
  url        String
  nombre     String?
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@map("fotos")
}

model HistorialDiseno {
  id         String   @id @default(cuid())
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  version    Int
  cambios    String?
  snapshot   String
  creadoPor  String
  createdAt  DateTime @default(now())

  @@map("historial_diseno")
}

model ProyectoDiseno {
  id              String             @id @default(cuid())
  nombre          String
  marca           String
  archivado       Boolean            @default(false)
  inspiracion     String?
  moodboard       String?
  molderia        String?
  molderiaFormato String?
  tela            String?
  fechaObjetivo   DateTime?
  fases           FaseProyecto[]
  iteraciones     IteracionMuestra[]
  insumos         ProyectoInsumo[]
  skus            SKUProyecto[]
  movimientos     MovimientoInsumo[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@map("proyectos_diseno")
}

// Idea liviana del Moodboard: nombre + marca + fotos. Al madurar se "convierte"
// en un ProyectoDiseno (copiando fotos → moodboard); proyectoId guarda la traza.
model Idea {
  id         String   @id @default(cuid())
  nombre     String
  marca      String
  fotos      String?  // JSON array de URLs (mismo formato que ProyectoDiseno.moodboard)
  notas      String?
  proyectoId String?  // set al convertir
  archivado  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("ideas")
}

// Diseño confirmado / geometral con estampa que ya se viene. Misma modalidad que
// el Moodboard (fotos), pero para lanzamientos confirmados: el equipo ve lo que
// se lanza sin consultar a diseño. Sin flujo de "convertir a proyecto".
model Lanzamiento {
  id            String    @id @default(cuid())
  nombre        String
  marca         String
  fotos         String?   // JSON array de URLs (mismo formato que Idea.fotos)
  estado        String    @default("Confirmado") // Confirmado | En producción | Lanzado
  fechaEstimada DateTime?
  notas         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("lanzamientos")
}

model FaseCatalogo {
  id        String         @id @default(cuid())
  nombre    String         @unique
  orden     Int            @default(0)
  activo    Boolean        @default(true)
  fases     FaseProyecto[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("fase_catalogo")
}

model FaseProyecto {
  id              String         @id @default(cuid())
  proyectoId      String
  proyecto        ProyectoDiseno @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  faseId          String
  fase            FaseCatalogo   @relation(fields: [faseId], references: [id])
  estado          String         @default("en_progreso") // en_progreso | completada
  responsable     String?
  externo         Boolean        @default(false)
  seguidorInterno String?
  fechaInicio     DateTime?
  fechaFin        DateTime?
  notas           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([proyectoId, faseId])
  @@map("fase_proyecto")
}

model IteracionMuestra {
  id              String          @id @default(cuid())
  proyectoId      String
  proyecto        ProyectoDiseno  @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  version         Int
  tipo            String          @default("muestra")
  estado          String          @default("en_confeccion")
  fotos           String?
  notas           String?         // qué falló / qué falta de la muestra física
  ajustesMolderia String?         // qué se cambió / se va a cambiar en la molderia
  ajustes         AjusteMuestra[]
  insumos         InsumoMuestra[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("iteraciones_muestra")
}

model AjusteMuestra {
  id             String           @id @default(cuid())
  iteracionId    String
  iteracion      IteracionMuestra @relation(fields: [iteracionId], references: [id], onDelete: Cascade)
  descripcion    String
  estado         String           @default("pendiente")
  fechaRealizado DateTime?
  createdAt      DateTime         @default(now())

  @@map("ajustes_muestra")
}

model InsumoMuestra {
  id          String           @id @default(cuid())
  iteracionId String
  iteracion   IteracionMuestra @relation(fields: [iteracionId], references: [id], onDelete: Cascade)
  nombre      String
  cantidad    Float            @default(1)
  unidad      String?
  costo       Float            @default(0)
  notas       String?

  @@map("insumos_muestra")
}

model ProyectoInsumo {
  id            String         @id @default(cuid())
  proyectoId    String
  proyecto      ProyectoDiseno @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  nombre        String
  tipo          String?
  proveedor     String?
  unidad        String         @default("m")
  cantidad      Float          @default(0)
  costoUnitario Float          @default(0)
  notas         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("proyecto_insumos")
}

model SKUProyecto {
  id         String         @id @default(cuid())
  proyectoId String
  proyecto   ProyectoDiseno @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  codigo     String
  talle      String?
  color      String?
  cantidad   Int            @default(0)
  notas      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@map("skus_proyecto")
}

model Usuario {
  id           String   @id @default(cuid())
  nombre       String
  username     String   @unique
  // Nullable: quien entra con Google no tiene contraseña propia (la identidad la
  // valida Supabase). Sigue habiendo login por contraseña para quien no tiene
  // casilla @arebensrl.com (cortador, costurera, genéricas).
  passwordHash String?
  // Vínculo con la cuenta de Google/Supabase. La unicidad la garantiza un índice
  // parcial case-insensitive creado por SQL (usuarios_email_key sobre LOWER(email)
  // WHERE email IS NOT NULL); NO se pone @unique acá para que `prisma db push` no
  // intente reemplazar ese índice por uno propio.
  email        String?
  rol          String   @default("admin")
  permisos     String[] @default([])
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("usuarios")
}

model GastoFijoTaller {
  id          String   @id @default(cuid())
  nombre      String
  monto       Float    @default(0)
  categoria   String   @default("otro")
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("gastos_fijos_taller")
}

model CostoCosturera {
  id              String   @id @default(cuid())
  usuarioId       String   @unique
  sueldoBruto     Float    @default(0)
  cargasSociales  Float    @default(0)
  horasMes        Float    @default(160)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("costos_costureras")
}

model ConfigCostos {
  id               String   @id @default("singleton")
  margenDesarrollo Float    @default(10)
  margenFallas     Float    @default(5)
  dtfPrecioMetro   Float    @default(0)  // precio fijo del DTF por metro (rollo)
  dtfAnchoCm       Float    @default(58) // ancho del rollo DTF
  dtfMermaDefault  Float    @default(0)  // % merma default de estampas
  estampadoValorHora Float  @default(0)  // $/hora de MO de estampería ($/min = /60)
  sublimacionPrecioMetro Float @default(0) // $/m lineal de sublimación de tela (precio vigente)
  ivaVenta         Float    @default(21)  // % IVA de venta (para separar PVP del costo neto)
  markupVentaDefault Float  @default(130) // markup % s/ costo por defecto (simulador de precios)
  iibbPct          Float    @default(0)   // % Ingresos Brutos sobre venta
  dreiPct          Float    @default(0)   // % DREI (derecho de registro e inspección) sobre venta
  gananciasPct     Float    @default(0)   // % Impuesto a las ganancias
  saldoIvaFavor    Boolean  @default(false) // si hay saldo de IVA a favor (afecta el margen neto en Sale)
  redondeoActivo      Boolean @default(true) // redondear los precios promo de Sale
  redondeoTerminacion Int     @default(90)   // los precios promo terminan en este número (90, 99, 990…)
  redondeoModo        String  @default("cercano") // cercano | arriba | abajo
  updatedAt        DateTime @updatedAt

  @@map("config_costos")
}

// Canal de venta (Local, Web, Mayorista…) con su costo por venta. Cada canal tiene
// sus propias formas de pago con comisiones. Config compartida del área Precios.
model CanalVenta {
  id            String         @id @default(cuid())
  nombre        String
  costoPorVenta Float          @default(0)     // costo del canal por venta
  costoEsPct    Boolean        @default(false) // true: % sobre la venta · false: $ fijo
  orden         Int            @default(0)
  activo        Boolean        @default(true)
  comisiones    ComisionPago[]

  @@map("canales_venta")
}

// Forma de pago dentro de un canal, con su comisión, costo financiero, descuento
// promocional, si le aplican impuestos y días de acreditación.
model ComisionPago {
  id                 String     @id @default(cuid())
  canalId            String
  canal              CanalVenta @relation(fields: [canalId], references: [id], onDelete: Cascade)
  nombre             String     // Efectivo, Transferencia, Débito, Crédito 3 cuotas…
  comisionPct        Float      @default(0)
  costoFinancieroPct Float      @default(0)
  descuentoPct       Float      @default(0)
  aplicaImpuestos    Boolean    @default(true)
  diasAcreditacion   Int        @default(0)
  orden              Int        @default(0)

  @@index([canalId])
  @@map("comisiones_pago")
}

model CostoSkuDescartado {
  sku       String   @id
  createdAt DateTime @default(now())

  @@map("costos_skus_descartados")
}

// Producto final con estampa: liso (escandallo referenciado, vivo) + estampa(s) del
// catálogo. Total = costo del liso + Σ (material DTF + estampería: minutos × valor hora).
model ProductoEstampado {
  id               String   @id @default(cuid())
  nombre           String
  sku              String?
  marca            String?
  lisoEscandalloId String   // ref viva al escandallo del liso (se resuelve al calcular)
  estampas         Json     // [{ estampaId, tamano, minutosEstampado }] (legacy: costoEstampado $)
  notas            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("productos_estampados")
}

model Escandallo {
  id              String   @id @default(cuid())
  nombre          String
  nombreComercial String?
  sku         String?
  marca       String?
  tipoPrenda  String?
  proyectoId  String?
  notas       String?
  datos       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("escandallos")
}

// Catálogo de AVÍOS (en la UI se llama "Avíos": etiquetas, badanas, botones,
// hilos). El modelo se llama EtiquetaCatalogo por historia; EtiquetaCatalogo ≡
// Avío. El escandallo elige el avío y autocompleta el precio (snapshot).
// Es el sistema liviano que reemplazó al pesado (Insumo+Lote) para avíos.
model EtiquetaCatalogo {
  id        String   @id @default(cuid())
  nombre    String
  tipo      String?  // 'principal' | 'composicion' | 'otro'
  categoria String?  // 'etiqueta' | 'badana' | 'boton' | 'cierre' | 'tacha' | 'hilo' | 'otro'
  frecuencia String  @default("habitual") // 'habitual' (va siempre) | 'ocasional' (según la prenda)
  unidad    String?  // 'etiqueta' | 'unidad'
  marca     String?  // 'Zattia' | 'Stunned' | null
  precio    Decimal  @default(0)
  stock     Int?     // null = sin seguimiento / ilimitado. Se descuenta al terminar producción.
  activo    Boolean  @default(true)
  proveedorId String?
  proveedor   Proveedor? @relation(fields: [proveedorId], references: [id])
  ordenAvios OrdenAvio[]
  movimientos AvioMovimiento[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("etiqueta_catalogo")
}

// Movimientos de stock de un avío (ingreso por compra, egreso al terminar
// producción, ajuste manual). gastoId enlaza al Gasto-compra cuando el ingreso
// vino de una compra a proveedor (aparece en el módulo Compras).
model AvioMovimiento {
  id            String           @id @default(cuid())
  etiquetaId    String
  etiqueta      EtiquetaCatalogo @relation(fields: [etiquetaId], references: [id], onDelete: Cascade)
  tipo          String           // 'INGRESO' | 'EGRESO' | 'AJUSTE'
  cantidad      Int              // + ingreso / - egreso
  costoUnitario Decimal?
  gastoId       String?
  proveedorId   String?
  ordenId       String?          // para egresos al terminar producción
  motivo        String?
  creadoPor     String
  fecha         DateTime         @default(now())

  @@index([etiquetaId])
  @@map("avio_movimientos")
}

// Qué avíos (del catálogo) lleva una orden. Se cargan al registrar el corte
// (ideal) o desde el escandallo (fallback). El stock se descuenta una sola vez
// al terminar producción (guard OrdenProduccion.aviosDescontados).
model OrdenAvio {
  id         String           @id @default(cuid())
  ordenId    String
  orden      OrdenProduccion  @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  etiquetaId String
  etiqueta   EtiquetaCatalogo @relation(fields: [etiquetaId], references: [id])
  cantidad   Int              @default(1) // cantidad por prenda
  origen     String           @default("corte") // 'corte' | 'escandallo'
  createdAt  DateTime         @default(now())

  @@unique([ordenId, etiquetaId])
  @@map("orden_avios")
}

// Costo de corte de referencia por tipo de prenda. Da independencia al cargar
// el costo de corte: se elige el tipo de prenda y trae el costo configurado.
model CostoCortePrenda {
  id         String   @id @default(cuid())
  tipoPrenda String   @unique
  costo      Decimal  @default(0)
  activo     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("costo_corte_prenda")
}

enum EstadoOP {
  PENDIENTE
  CORTE
  COSTURA
  TERMINADO_SIN_ESTAMPA
  ESTAMPA
  CONTROL_CALIDAD
  CERRADA
}

model OrdenProduccion {
  id                      String    @id @default(cuid())
  sku                     String?   @unique
  descripcion             String?
  marca                   String    @default("Zattia")
  cantidad                Int       @default(1)
  estado                  EstadoOP  @default(PENDIENTE)
  notas                   String?
  creadoPor               String    @default("admin")
  terminadoAt             DateTime?

  fichaCorteCargada       Boolean   @default(false)
  fichaFotoUrl            String?
  fichaCorteData          Json?     // estado del form de corte tal cual se cargó (para ver/editar idéntico)
  fechaCorte              DateTime? // fecha en que se hizo el corte (para coordinar pagos al cortador)
  corteEstado             String?   // panel cortador: null | 'asignado' | 'cargado' (falta que la diseñadora asigne rollo y valide)

  avios                   OrdenAvio[]
  aviosDescontados        Boolean   @default(false) // guard: el stock de avíos se descuenta una sola vez

  cortador                String?
  cortadorId              String?
  cortadorRef             Cortador? @relation(fields: [cortadorId], references: [id])
  costoCorte              Decimal   @default(0)
  pagoCorteId             String?
  pagoCorte               PagoCorte? @relation(fields: [pagoCorteId], references: [id])

  costoTela               Decimal   @default(0)
  costoInsumosSecundarios Decimal   @default(0)
  costoManoObra           Decimal   @default(0)
  costoEstampa            Decimal   @default(0)
  // Sublimación de tela: se cobra por metro lineal de los metros que se le piden al
  // sublimador (no de los que se cortan). Rubro propio: no va en costoCorte (que es lo
  // que se le paga al cortador) ni en costoTela (que reconcilia contra los rollos).
  costoSublimacion        Decimal   @default(0)
  metrosSublimados        Decimal   @default(0)
  costoTotal              Decimal   @default(0)

  transiciones            EstadoTransicion[]
  movimientosInsumo       MovimientoInsumo[]
  cortesPorTalle          CortePorTalle[]

  loteId                  String?
  lote                    LoteProduccion? @relation(fields: [loteId], references: [id], onDelete: SetNull)

  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([loteId])
  @@map("ordenes_produccion")
}

// Agrupa las órdenes hermanas (mismo molde/prenda, distinto color) de una misma
// producción. Es opcional y aditivo: una OP sin lote funciona como siempre.
model LoteProduccion {
  id          String            @id @default(cuid())
  marca       String            @default("Zattia")
  prenda      String?           // abreviatura de la prenda (molde)
  descripcion String?
  notas       String?
  creadoPor   String            @default("admin")
  ordenes     OrdenProduccion[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("lotes_produccion")
}

model CortePorTalle {
  id        String          @id @default(cuid())
  ordenId   String
  orden     OrdenProduccion @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  talle     String
  cantidad  Int
  createdAt DateTime        @default(now())

  @@unique([ordenId, talle])
  @@map("cortes_por_talle")
}

model PagoCorte {
  id             String            @id @default(cuid())
  fecha          DateTime          @default(now())
  beneficiario   String
  montoTotal     Decimal
  notas          String?
  comprobanteUrl String?
  creadoPor      String
  createdAt      DateTime          @default(now())
  ordenes        OrdenProduccion[]
  muestras       CorteMuestra[]

  @@map("pagos_cortes")
}

model Cortador {
  id            String            @id @default(cuid())
  nombre        String            @unique
  contacto      String?
  tarifaDefault Decimal?
  tarifaModo    String?           // 'total' | 'unidad'
  notas         String?
  usuarioId     String?           @unique // usuario de login del cortador (panel propio)
  activo        Boolean           @default(true)
  ordenes       OrdenProduccion[]
  muestras      CorteMuestra[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@map("cortadores")
}

// Corte de muestra cargado por el cortador (aparte de la producción): consumo y valor.
model CorteMuestra {
  id         String   @id @default(cuid())
  cortadorId String
  cortador   Cortador @relation(fields: [cortadorId], references: [id])
  descripcion String
  consumo    Decimal  @default(0) // metros/kg de la tizada de muestra
  unidad     String   @default("m")
  valor      Decimal  @default(0) // valor del corte de muestra (cobro)
  estado     String   @default("pendiente") // 'pendiente' | 'validado'
  pagoCorteId String?
  pagoCorte  PagoCorte? @relation(fields: [pagoCorteId], references: [id])
  fecha      DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([cortadorId])
  @@map("cortes_muestra")
}

model MotivoDescarte {
  id          String             @id @default(cuid())
  nombre      String             @unique
  categoria   String             // 'proveedor' | 'corte' | 'costura' | 'estampa' | 'otro'
  activo      Boolean            @default(true)
  movimientos MovimientoInsumo[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("motivos_descarte")
}

model EstadoTransicion {
  id             String           @id @default(cuid())
  ordenId        String
  orden          OrdenProduccion  @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  estadoAnterior EstadoOP?
  estadoNuevo    EstadoOP
  fecha          DateTime         @default(now())
  usuarioId      String
  notas          String?

  @@map("estado_transiciones")
}

model MolderiaCatalogo {
  id        String   @id @default(cuid())
  nombre    String   @unique
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("molderia_catalogo")
}

model TelaCatalogo {
  id          String   @id @default(cuid())
  nombre      String   @unique
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tela_catalogo")
}

model Gasto {
  id        String   @id @default(cuid())
  categoria String   // 'desarrollo' | 'produccion'
  tipo      String   // 'tela' | 'insumos' | 'periodo'
  marca     String?  // 'Zattia' | 'Stunned' — para desarrollo
  sku       String?
  ordenId   String?  // FK a OrdenProduccion — para produccion
  minutos   Int?
  monto     Float    @default(0)
  concepto  String?
  fecha     String
  creadoPor String
  tiempoId  String?

  // Retiro de tela para muestra (MovimientoInsumo tipo MUESTRA) que generó este
  // gasto. FK suelta sin relación Prisma, mismo criterio que ordenId/tiempoId.
  // Es lo que permite borrar o reajustar el gasto cuando se edita o elimina el
  // retiro: sin este vínculo el gasto quedaba huérfano.
  movimientoId String?

  // Compra a proveedor (cuando proveedorId != null, el gasto es una "compra" y
  // aparece en el módulo Compras). Los gastos automáticos van sin proveedor.
  proveedorId   String?
  proveedor     Proveedor?  @relation(fields: [proveedorId], references: [id])
  numeroFactura String?
  formaPago     String?
  estadoPago    EstadoPago? // null = sin seguimiento de pago (registro simple)
  montoPagado   Decimal?
  fechaPago     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([movimientoId])
  @@map("gastos")
}

// ─── Capital de Producción — Fase 1 ────────────────────────────────

model Proveedor {
  id           String   @id @default(cuid())
  nombre       String
  cuit         String?
  condicionIva String?
  contacto     String?
  notas        String?
  activo       Boolean  @default(true)
  compras      Compra[]
  gastos       Gasto[]
  etiquetas    EtiquetaCatalogo[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("proveedores")
}

enum EstadoPago {
  PENDIENTE
  PARCIAL
  PAGADA
}

model Compra {
  id            String     @id @default(cuid())
  proveedorId   String
  proveedor     Proveedor  @relation(fields: [proveedorId], references: [id])
  fecha         DateTime
  numeroFactura String?
  conIva        Boolean    @default(true)
  totalBruto    Decimal
  totalNeto     Decimal
  costoEnvio    Decimal    @default(0) // flete/envío en pesos, prorrateado al costo de los rollos/lotes (si fleteModo='porcentaje', es el equivalente calculado)
  fleteModo     String     @default("monto")  // 'monto' (pesos) | 'porcentaje'
  fletePorcentaje Decimal? // % ingresado cuando fleteModo='porcentaje' (para recordarlo al editar)
  formaPago     String?
  estadoPago    EstadoPago @default(PENDIENTE)
  montoPagado   Decimal    @default(0)
  fechaPago     DateTime?
  notas         String?
  revertida     Boolean    @default(false)
  revertidaAt   DateTime?
  revertidaPor  String?
  creadoPor     String
  creadoAt      DateTime   @default(now())
  lineas        CompraLinea[]
  rollos        Rollo[]
  lotes         Lote[]

  @@map("compras")
}

model CompraLinea {
  id             String  @id @default(cuid())
  compraId       String
  compra         Compra  @relation(fields: [compraId], references: [id], onDelete: Cascade)
  insumoId       String
  insumo         Insumo  @relation(fields: [insumoId], references: [id])
  cantidad       Decimal
  unidad         String
  precioUnitario Decimal
  subtotal       Decimal
  rollos         Rollo[]
  lotes          Lote[]

  @@map("compra_lineas")
}

model Insumo {
  id               String        @id @default(cuid())
  nombre           String                       // nombre del artículo (suele ser el del proveedor)
  nombreInterno    String?                      // nombre interno opcional (ref al catálogo de telas)
  categoria        String
  tipoTrazabilidad String
  unidadDefault    String
  stockMinimo      Decimal?
  manejaColor      Boolean       @default(false)
  rinde            Decimal?
  activo           Boolean       @default(true)
  colores          InsumoColor[]
  rollos           Rollo[]
  lotes            Lote[]
  lineasCompra     CompraLinea[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@map("insumos")
}

model InsumoColor {
  id             String      @id @default(cuid())
  insumoId       String
  insumo         Insumo      @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  skuCatalogoId  String
  skuCatalogo    SkuCatalogo @relation(fields: [skuCatalogoId], references: [id])
  activo         Boolean     @default(true)

  @@unique([insumoId, skuCatalogoId])
  @@map("insumo_colores")
}

enum EstadoRollo {
  DISPONIBLE
  EN_USO_PARCIAL
  AGOTADO
  DESCARTADO
}

model Rollo {
  id            String             @id @default(cuid())
  codigo        String             @unique
  insumoId      String
  insumo        Insumo             @relation(fields: [insumoId], references: [id])
  colorId       String?
  color         SkuCatalogo?       @relation("RolloColor", fields: [colorId], references: [id])
  colorProveedor String?           // nombre comercial del color que pone el proveedor (ej. "Lindt")
  compraId      String
  compra        Compra             @relation(fields: [compraId], references: [id])
  compraLineaId String?
  compraLinea   CompraLinea?       @relation(fields: [compraLineaId], references: [id], onDelete: SetNull)
  pesoInicial   Decimal
  pesoActual    Decimal
  costoUnitario Decimal
  moneda        String             @default("ARS") // 'ARS' | 'USD' — moneda original de la compra
  costoUnitarioUsd Decimal?         // costo unitario en USD (si moneda='USD'); para revaluar a un TC nuevo
  estado        EstadoRollo        @default(DISPONIBLE)
  ubicacion     String?
  fotoUrl       String?
  movimientos   MovimientoInsumo[]
  createdAt     DateTime           @default(now())

  @@map("rollos")
}

enum EstadoLote {
  DISPONIBLE
  EN_USO_PARCIAL
  AGOTADO
}

model Lote {
  id              String             @id @default(cuid())
  codigo          String             @unique
  insumoId        String
  insumo          Insumo             @relation(fields: [insumoId], references: [id])
  colorId         String?
  color           SkuCatalogo?       @relation("LoteColor", fields: [colorId], references: [id])
  colorProveedor  String?            // nombre comercial del color que pone el proveedor (ej. "Lindt")
  compraId        String
  compra          Compra             @relation(fields: [compraId], references: [id])
  compraLineaId   String?
  compraLinea     CompraLinea?       @relation(fields: [compraLineaId], references: [id], onDelete: SetNull)
  cantidadInicial Decimal
  cantidadActual  Decimal
  costoUnitario   Decimal
  moneda          String             @default("ARS") // 'ARS' | 'USD'
  costoUnitarioUsd Decimal?          // costo unitario en USD (si moneda='USD'); para revaluar a un TC nuevo
  estado          EstadoLote         @default(DISPONIBLE)
  movimientos     MovimientoInsumo[]
  createdAt       DateTime           @default(now())

  @@map("lotes")
}

enum TipoMovimiento {
  INGRESO
  CONSUMO
  AJUSTE
  DESCARTE
  REVERSION
  MUESTRA
}

model MovimientoInsumo {
  id               String            @id @default(cuid())
  tipo             TipoMovimiento
  rolloId          String?
  rollo            Rollo?            @relation(fields: [rolloId], references: [id])
  loteId           String?
  lote             Lote?             @relation(fields: [loteId], references: [id])
  ordenId          String?
  orden            OrdenProduccion?  @relation(fields: [ordenId], references: [id])
  proyectoId       String?
  proyecto         ProyectoDiseno?   @relation(fields: [proyectoId], references: [id])
  cantidad         Decimal
  motivo           String?
  // Solo la escriben los retiros para muestra (tipo MUESTRA): es la marca a la
  // que se le imputa el desarrollo. El resto de los movimientos la dejan null.
  marca            String?
  motivoDescarteId String?
  motivoDescarte   MotivoDescarte?   @relation(fields: [motivoDescarteId], references: [id])
  fotoUrl          String?
  usuarioId        String
  fecha            DateTime          @default(now())
  revertidoPor     String?
  reversionNota    String?

  @@map("movimientos_insumo")
}

// ─── Stock de productos terminados (lisos / estampados) ────────────────
// Lo que sale de costura (liso) ingresa acá por SKU + talle. Estampa
// consumirá lisos y generará estampados (mismo modelo, tipo distinto).

model StockTerminado {
  id        String   @id @default(cuid())
  sku       String
  talle     String
  tipo      String   @default("liso") // 'liso' | 'estampado'
  cantidad  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sku, talle, tipo])
  @@index([sku])
  @@map("stock_terminado")
}

model MovimientoTerminado {
  id        String   @id @default(cuid())
  sku       String
  talle     String
  tipo      String   @default("liso")
  cantidad  Int      // + ingreso / - egreso
  origen    String   // 'produccion' | 'estampa' | 'venta' | 'ajuste'
  ordenId   String?
  motivo    String?
  creadoPor String
  fecha     DateTime @default(now())

  @@index([sku])
  @@map("movimientos_terminado")
}

// Reposición: vincula un producto de Gestión Nube (código) con un liso de areben.
// Muchos productos finales (estampados) pueden mapear a un mismo liso.
model ReposicionMapeo {
  id        String   @id @default(cuid())
  gnId      Int      @unique          // id del producto en Gestión Nube (clave real)
  gnCode    String?                   // código de GN, solo display
  gnNombre  String?                   // nombre denormalizado (para mostrar)
  skuLiso   String                    // estampa: SKU del liso base · produccion: SKU/molde a producir
  tipo      String   @default("estampa") // 'estampa' (desde liso) | 'produccion' (directa)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([skuLiso])
  @@map("reposicion_mapeo")
}

// Copia local de los productos de producción propia (Zattia/Areben) de Gestión Nube,
// para listarlos al vincular sin pegarle a la API en cada uso. Se refresca con "Sincronizar".
model GnProducto {
  gnId     Int      @id            // id numérico del producto en Gestión Nube (único de verdad)
  code     String?                 // "código" de GN (NO es único: suele venir vacío/repetido), solo display
  name     String
  provider String
  category String?
  precioRetail     Float?          // retailer_price de GN: PVP minorista (IVA incluido)
  precioMayorista  Float?          // wholesaler_price de GN: precio mayorista
  syncedAt DateTime @default(now()) @updatedAt

  @@map("gn_productos")
}

// Override manual del PVP por producto GN (correción o cuando GN no trae precio).
// Separado de GnProducto para que la sync no lo pise. PVP efectivo = pvpManual ?? GnProducto.precioRetail.
model PrecioProducto {
  gnId              Int       @id     // id del producto en Gestión Nube
  pvpManual         Float?            // override manual del PVP minorista (IVA incluido)
  costoManual       Float?            // costo neto cargado a mano (cuando el SKU no matchea un escandallo)
  precioPromo       Float?            // precio promocional confirmado en Sale (c/IVA); null = sin promo
  promoDescuentoPct Float?            // % de descuento con el que se confirmó la promo
  promoAt           DateTime?         // cuándo se confirmó la promo
  updatedAt         DateTime  @updatedAt

  @@map("precios_producto")
}

// Cursor de la sincronización del catálogo GN (resumible): permite continuar donde
// quedó si la API se satura a mitad, y que el cron nocturno la complete.
model GnSyncEstado {
  id        String   @id @default("main")
  lastPage  Int      @default(0)
  total     Int      @default(0)
  completo  Boolean  @default(false)
  updatedAt DateTime @updatedAt @default(now())

  @@map("gn_sync_estado")
}

// Caché del stock de venta (Gestión Nube) por producto+talle. El reporte lee de acá
// (no pega a la API en cada uso); se refresca ~1 vez por día (cron) o a mano.
model GnStock {
  id       String   @id @default(cuid())
  gnId     Int
  talle    String
  cantidad Int      @default(0)
  syncedAt DateTime @updatedAt @default(now())

  @@unique([gnId, talle])
  @@index([gnId])
  @@map("gn_stock")
}

// Caché de ventas por producto GN + talle (unidades vendidas en ventanas móviles). Se
// refresca 1×día (cron) leyendo /ventas con detalle. Sirve para entender el ritmo de
// venta y cuánto recomprar/estampar. v90 incluye v30 incluye v7 (acumulado).
model GnVentas {
  id       String   @id @default(cuid())
  gnId     Int
  talle    String
  v7       Int      @default(0)
  v30      Int      @default(0)
  v90      Int      @default(0)
  syncedAt DateTime @updatedAt @default(now())

  @@unique([gnId, talle])
  @@index([gnId])
  @@map("gn_ventas")
}

// Orden de estampa generada desde el reporte: qué estampar (por print/talle), para
// que la diseñadora la ejecute.
model OrdenEstampa {
  id        String             @id @default(cuid())
  creadoPor String
  creadoAt  DateTime           @default(now())
  estado    String             @default("pendiente") // 'pendiente' | 'parcial' | 'hecha'
  tipo      String             @default("estampa")   // 'estampa' (descuenta liso) | 'produccion' (informativa)
  notas     String?
  items     OrdenEstampaItem[]

  @@map("ordenes_estampa")
}

model OrdenEstampaItem {
  id         String       @id @default(cuid())
  ordenId    String
  orden      OrdenEstampa @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  gnId       Int
  gnNombre   String?      // nombre del estampado (print)
  skuLiso    String       // liso base
  talle      String
  cantidad   Int          // pedido
  confirmado Int          @default(0) // estampado/confirmado (descuenta liso); pendiente = cantidad - confirmado

  @@index([ordenId])
  @@index([skuLiso])
  @@map("ordenes_estampa_items")
}

// Config del módulo de reposición (singleton). minimoDefault aplica a todo lo que no
// tenga un mínimo específico cargado.
model ReposicionConfig {
  id            String @id @default("main")
  minimoDefault Int    @default(1)

  @@map("reposicion_config")
}

// Stock mínimo deseado de un ESTAMPADO (producto GN) por talle. Si el stock de venta
// cae por debajo → estampar la diferencia. Es la base de la orden de estampa.
// Solo se cargan EXCEPCIONES; el resto usa ReposicionConfig.minimoDefault.
model ReposicionMinimo {
  id     String @id @default(cuid())
  gnId   Int
  talle  String
  minimo Int    @default(0)

  @@unique([gnId, talle])
  @@map("reposicion_minimo")
}

model Estampa {
  id              String   @id @default(cuid())
  codigoInterno   String   // ref de la diseñadora (lo único obligatorio)
  nombreComercial String?  // diferido: se pone después, no bloquea la carga
  coleccion       String?
  imagenUrl       String?  // opcional (URL; sin upload por ahora)
  precioMetroDtf  Decimal  @default(0) // (dormido) el precio ahora es global en ConfigCostos
  anchoCm         Decimal  @default(0) // ancho del diseño (cm)
  largoCm         Decimal  @default(0) // largo del diseño (cm)
  mermaPercent    Decimal  @default(0) // % de merma/aprovechamiento
  ancho2Cm        Decimal  @default(0) // 2º tamaño opcional (0 = no tiene)
  largo2Cm        Decimal  @default(0)
  merma2Percent   Decimal  @default(0)
  estado          String   @default("pensada") // 'pensada' | 'pedida' | 'recibida'
  sku             String?  // producto vinculado (diferido)
  notas           String?
  creadoPor       String   @default("admin")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("estampas")
}
